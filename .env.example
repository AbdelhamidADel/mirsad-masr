# ─────────────────────────────────────────────────────────────────────────────
# MIRSAD MASR — environment variable reference
# Copy to .env and fill in the values you need.
# Providers with no key are automatically excluded from the fetcher chain.
# ─────────────────────────────────────────────────────────────────────────────

# ── /v1 endpoints — user-supplied keys ───────────────────────────────────────
# These are YOUR keys. They never leave your server.

# Alpha Vantage free tier: 25 req/day — https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=

# Finnhub free tier: 60 req/min — https://finnhub.io/register
FINNHUB_KEY=

# ── /demo endpoint — operator-supplied keys ───────────────────────────────────
# Keys used by the public demo widget. Separate from user keys so you can
# apply stricter rate limits without affecting authenticated users.

DEMO_ALPHA_VANTAGE_KEY=
DEMO_FINNHUB_KEY=

# ── Demo rate limit ───────────────────────────────────────────────────────────
# Global requests/day cap for the /demo endpoint (default: 50)
DEMO_DAILY_LIMIT=50

# ── Cache ─────────────────────────────────────────────────────────────────────
# TTL in seconds for /v1 quotes (default: 30 — near-live polling of delayed EGX)
CACHE_TTL_SECONDS=30
# TTL in seconds for /demo quotes (default: 60)
DEMO_CACHE_TTL_SECONDS=60
# Maximum cached entries (default: 512)
CACHE_MAX_SIZE=512
# Fetch all /v1 quotes when the app starts (default: true)
FETCH_QUOTES_ON_STARTUP=true
# Refresh all /v1 quotes every CACHE_TTL_SECONDS (default: true)
AUTO_REFRESH_QUOTES=true
# Enable unofficial Yahoo Finance/yfinance fetching. Review Yahoo/yfinance terms first.
ENABLE_YAHOO_FINANCE=false

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: debug | info | warning | error
LOG_LEVEL=info
# Set to true for pretty coloured console output (development only)
DEV_MODE=false

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Email alerts (optional) ───────────────────────────────────────────────────
# Postgres URL (Render / Neon). Leave empty to keep alerts off.
DATABASE_URL=
# Set true only after DATABASE_URL + mail are configured.
ALERTS_ENABLED=false
# Preferred on Render free tier (SMTP ports are blocked there). https://resend.com
RESEND_API_KEY=
# Optional local/paid-host fallback (blocked on Render free: ports 25/465/587).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# Gmail App Password — never commit the real value.
SMTP_PASSWORD=
# From address. With Resend: must be a verified domain sender (or onboarding address).
SMTP_FROM=
# Public site URL used in confirm / manage links.
ALERTS_PUBLIC_BASE_URL=http://127.0.0.1:8000
# Shared secret for POST /v1/alerts/tick (cron wake). Empty = open (dev only).
ALERTS_TICK_SECRET=
ALERTS_COOLDOWN_HOURS_DEFAULT=6

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins, or * for all. Default: *
# Public demo API example:
# CORS_ORIGINS=https://egxdesk.ashh.me,https://www.egxdesk.ashh.me
# Optional regex for Vercel preview deployments:
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
